#pragma once

/* Build-time secrets for MimiClaw on RAKSA
 * Copy this file to "mimi_secrets.h" and set your real API key.
 * NOTE: mimi_secrets.h is ignored by git and should never be committed.
 */

// Gemini API Key from Google AI Studio (https://aistudio.google.com)
#define MIMI_SECRET_API_KEY         "YOUR_GEMINI_API_KEY_HERE"

// Model Name (Gemini 2.5 Flash recommended for fast edge inference)
#define MIMI_SECRET_MODEL           "gemini-2.5-flash"

// Provider set to "openai" to use Gemini's OpenAI-compatible chat completions endpoint
#define MIMI_SECRET_MODEL_PROVIDER  "openai"
